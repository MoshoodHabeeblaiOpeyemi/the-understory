# Enforce LF on text files in the repo (no CRLF churn on Windows).
# Generated output, logs, and large binaries are left alone.
*.astro text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonld text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf
*.txt text eol=lf
