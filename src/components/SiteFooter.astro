---
// SiteFooter — the soil beneath the page: a shaded room, not a ruled strip.
const year = new Date().getFullYear();

const explore = [
  { href: "/modules", label: "Modules" },
  { href: "/glossary", label: "Glossary" },
  { href: "/field-notes", label: "Field Notes" },
  { href: "/about", label: "About" },
];

const social = [
  {
    href: "https://www.linkedin.com/in/moshood-habeeblai-967b14294",
    label: "LinkedIn",
    accent: true,
  },
  {
    href: "https://github.com/MoshoodHabeeblaiOpeyemi",
    label: "GitHub",
    aria: "GitHub profile",
  },
  {
    href: "https://greatsage.codes",
    label: "greatsage.codes",
    aria: "My personal site",
  },
  {
    href: "https://wa.me/2347040717939?text=Hi%2C%20I%20read%20your%20work%20on%20The%20Understory%20and%20I%27d%20like%20to%20connect%20—%20what%20you%20build%20matters,%20and%20I%20want%20to%20be%20part%20of%20it.",
    label: "WhatsApp",
    aria: "Send a WhatsApp message",
  },
];
---
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-mark" href="/" aria-label="The Understory — home">
        <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
          <rect class="f-tile" width="64" height="64" rx="14" />
          <path class="f-cut f-stem" d="M32 49V31" />
          <path
            class="f-cut"
            d="M32 36C23.5 36 18 30.5 17 21C26.5 22 32 27.5 32 36Z"
          />
          <path
            class="f-cut"
            d="M32 30C32 21 37.5 15.5 47 14.5C46 24 40.5 30 32 30Z"
          />
        </svg>
        <span class="footer-name">The Understory</span>
      </a>
      <p class="footer-mission">
        A 193-day reading room for self-taught developers — the vocabulary,
        the history, and the mental models the tutorials skipped.
      </p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <p class="footer-heading">Explore</p>
      <ul>
        {
          explore.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-heading">The daily loop</p>
      <ol class="footer-loop">
        <li>Read, slowly.</li>
        <li>Explain it out loud.</li>
        <li>Write three sentences.</li>
      </ol>
    </div>

    <div class="footer-col footer-social">
      <p class="footer-heading">The builder</p>
      <p class="footer-creator">
        Moshood Habeeblai Opeyemi (Great Sage) — self-taught builder, currently teaching
        the layer of web development tutorials skip.
      </p>
      <ul class="footer-social-list">
        {
          social.map((s) => (
            <li class={s.accent ? "social-accent" : undefined}>
              <a href={s.href} aria-label={s.aria}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-base">
    <p>© {year} The Understory</p>
    <p>Built slowly, in public.</p>
  </div>
</footer>

<style>
  /* No divider on top — the background change IS the separation. */
  .site-footer {
    margin-top: var(--space-3xl);
    background-color: var(--color-footer-bg);
    color: var(--color-footer-ink);
    padding-block: var(--space-2xl) var(--space-l);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
  }

  .footer-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .footer-mark .mark {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .footer-mark:hover .mark {
    transform: rotate(-6deg) scale(1.05);
  }

  /* The mark's cut-outs take the footer's own soil color, so it reads as
     engraved in the floor rather than pasted on top of it. */
  .f-tile {
    fill: var(--color-footer-accent);
  }

  .f-cut {
    fill: var(--color-footer-bg);
  }

  .f-stem {
    stroke: var(--color-footer-bg);
    stroke-width: 4.5;
    stroke-linecap: round;
    fill: none;
  }

  .footer-name {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-footer-ink);
  }

  .footer-mission {
    max-width: 30rem;
    margin-top: var(--space-s);
    color: var(--color-footer-ink-muted);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .footer-heading {
    margin-bottom: var(--space-s);
    color: var(--color-footer-ink-muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-col ul,
  .footer-col ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .footer-col a {
    color: var(--color-footer-ink-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--color-footer-accent);
  }

  .footer-loop {
    color: var(--color-footer-ink-muted);
    font-size: var(--step--1);
    counter-reset: loop;
  }

  .footer-loop li {
    counter-increment: loop;
  }

  .footer-loop li::before {
    content: counter(loop) ".";
    margin-right: var(--space-2xs);
    color: var(--color-footer-accent);
    font-weight: 600;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-footer-border);
    color: var(--color-footer-ink-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 767.98px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  /* --- The builder column ---------------------------------------------------- */

  .footer-social {
    grid-column: auto;
  }

  .footer-creator {
    max-width: 32rem;
    margin-top: var(--space-2xs);
    color: var(--color-footer-ink-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .footer-social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    margin-top: var(--space-s);
  }

  .footer-social-list a {
    padding: 0.2em 0.6em;
    border: 1px solid var(--color-footer-border);
    border-radius: var(--radius-sm);
    color: var(--color-footer-ink-muted);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .footer-social-list a:hover {
    border-color: var(--color-footer-accent);
    color: var(--color-footer-accent);
    background-color: color-mix(
      in srgb,
      var(--color-footer-accent) 10%,
      transparent
    );
  }

  /* The primary link (LinkedIn) gets the accent underline — quiet, never shouting. */
  .social-accent > a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-footer-accent);
    text-underline-offset: 3px;
  }
</style>
