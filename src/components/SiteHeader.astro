---
// This is the component script. It runs at build time.
---

<header class="site-header">
  <a href="/" class="logo-link">
    <img src="/images/logo.svg" alt="The Understory" class="logo" />
  </a>

  <nav id="site-nav" class="site-nav">
    <a href="/">Home</a>
    <a href="/modules">Modules</a>
    <a href="/glossary">Glossary</a>
    <a href="/field-notes">Field Notes</a>
    <a href="/about">About</a>
  </nav>

  <button id="theme-toggle" aria-label="Toggle dark mode">🌙</button>

  <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme) {
      document.documentElement.setAttribute("data-theme", savedTheme);
    }

    const toggleButton = document.getElementById("theme-toggle");
    const htmlElement = document.documentElement;

    if (toggleButton) {
      toggleButton.addEventListener("click", () => {
        const currentTheme = htmlElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        htmlElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      });
    }

    // Hamburger menu: find the button and the nav it controls
    const navToggle = document.querySelector(".nav-toggle");
    const siteNav = document.getElementById("site-nav");

    if (navToggle && siteNav) {
      navToggle.addEventListener("click", () => {
        const isOpen = siteNav.classList.toggle("is-open");
        navToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });
    }
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-bottom: 1px solid #e5e5e5;
  }

  .logo {
    height: 40px;
    width: auto;
    display: block;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    order: 3;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 500;
  }

  #theme-toggle {
    background: none;
    border: 1px solid var(--text-color);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-size: 1.25rem;
    color: var(--text-color);
  }

  @media (min-width: 768px) {
    .site-nav {
      width: auto;
      order: 0;
    }
  }

  /* Hamburger button — hidden on desktop, shown on mobile */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: 1px solid var(--text-color);
    border-radius: 6px;
    padding: 10px 8px;
    cursor: pointer;
  }

  .nav-toggle .bar {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--text-color);
  }

  /* Mobile: hide the nav until the hamburger opens it */
  @media (max-width: 767.98px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      flex-direction: column;
      align-items: center;
    }

    .site-nav.is-open {
      display: flex;
    }
  }
</style>
