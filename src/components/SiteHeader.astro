---
// Site chrome: logo, primary nav, theme toggle, mobile menu.
// The initial theme is applied pre-paint by BaseLayout's inline script —
// this component only flips it and persists the reader's choice.

// The homepage doesn't need a Home link (the logo is home); everywhere
// else Home leads the nav — the way back is never more than one tap.
// Decided at build time, per page, so it's baked rather than scripted.
const path = Astro.url.pathname;
const links = [
  ...(path === "/" ? [] : [{ href: "/", label: "Home" }]),
  { href: "/modules", label: "Modules" },
  { href: "/glossary", label: "Glossary" },
  { href: "/field-notes", label: "Field Notes" },
  { href: "/about", label: "About" },
];

// Exact match for "/" — prefix matching would light the Home underline on
// every page, since every path starts with "/".
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label="The Understory — home">
      <!-- Same geometry as favicon.svg, painted with theme tokens so the
          mark swaps with the site like every other surface. -->
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect class="mark-tile" width="64" height="64" rx="14" />
        <path class="mark-cut mark-stem" d="M32 49V31" />
        <path
          class="mark-cut"
          d="M32 36C23.5 36 18 30.5 17 21C26.5 22 32 27.5 32 36Z"
        />
        <path
          class="mark-cut"
          d="M32 30C32 21 37.5 15.5 47 14.5C46 24 40.5 30 32 30Z"
        />
      </svg>
      <span class="wordmark">The Understory</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle theme"
      >
        <svg
          class="icon icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"
          /><path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          /></svg
        >
        <svg
          class="icon icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg
        >
      </button>

      <button
        type="button"
        class="search-trigger"
        data-search-open
        aria-label="Search lessons"
        aria-keyshortcuts="Control+K Meta+K"
        title="Search (Ctrl+K)"
      >
        <svg
          class="icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd>Ctrl K</kbd>
      </button>

      <button
        class="nav-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>


<script>
  // Chrome behaviors. Two facts shape this script:
  //  1. The ClientRouter swaps the header on every navigation, killing
  //     its listeners.
  //  2. Bundled module scripts execute only once per session.
  // So bindChrome() runs on load AND after every astro:after-swap, and a
  // data-bound guard keeps a double call from attaching listeners twice.
  const bindChrome = () => {
    // --- Search trigger: platform-true shortcut hint ------------------------
    const kbd = document.querySelector<HTMLSpanElement>(
      ".search-trigger kbd",
    );
    if (kbd && !kbd.dataset.bound) {
      kbd.dataset.bound = "1";
      if (/Mac|iPhone|iPad/i.test(navigator.platform)) kbd.textContent = "⌘K";
    }

    // --- Theme toggle -------------------------------------------------------
    const root = document.documentElement;
    const toggle = document.getElementById("theme-toggle");

    if (toggle && !toggle.dataset.bound) {
      toggle.dataset.bound = "1";
      const syncLabel = () => {
        toggle.setAttribute(
          "aria-label",
          root.dataset.theme === "dark"
            ? "Switch to light theme"
            : "Switch to dark theme",
        );
      };
      syncLabel();
      toggle.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("understory.theme", next);
        } catch {
          /* Private mode — theme just won't persist. */
        }
        syncLabel();
      });
    }

    // --- Mobile menu ----------------------------------------------------------
    const navToggle = document.querySelector(".nav-toggle");
    const siteNav = document.getElementById("site-nav");
    if (!navToggle || !siteNav || navToggle.dataset.bound) return;
    navToggle.dataset.bound = "1";

    const closeMenu = (returnFocus = false) => {
      siteNav.classList.remove("is-open");
      navToggle.setAttribute("aria-expanded", "false");
      if (returnFocus) navToggle.focus();
    };

    navToggle.addEventListener("click", () => {
      const open = siteNav.classList.toggle("is-open");
      navToggle.setAttribute("aria-expanded", String(open));
    });

    // Choosing a destination is also the moment to close the menu.
    siteNav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        closeMenu();
      }
    });
  };

  // Document-level listeners survive the swap — register once, and look up
  // the live menu each time instead of holding stale node references.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const siteNav = document.getElementById("site-nav");
    if (!siteNav?.classList.contains("is-open")) return;
    siteNav.classList.remove("is-open");
    const navToggle = document.querySelector(".nav-toggle");
    navToggle?.setAttribute("aria-expanded", "false");
    navToggle?.focus();
  });

  document.addEventListener("click", (event) => {
    const siteNav = document.getElementById("site-nav");
    const navToggle = document.querySelector(".nav-toggle");
    if (!siteNav?.classList.contains("is-open")) return;
    if (
      event.target instanceof Node &&
      !siteNav.contains(event.target) &&
      !navToggle?.contains(event.target)
    ) {
      siteNav.classList.remove("is-open");
      navToggle?.setAttribute("aria-expanded", "false");
    }
  });

  bindChrome();
  document.addEventListener("astro:after-swap", bindChrome);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--header-h);
  }

  /* The mark IS the favicon — same geometry, painted with tokens so tile
     and sprout swap with the theme like every other surface. */
  .logo-link {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .mark {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .logo-link:hover .mark {
    transform: rotate(-6deg) scale(1.06);
  }

  .mark-tile {
    fill: var(--color-accent);
  }

  .mark-cut {
    fill: var(--color-bg);
  }

  .mark-stem {
    stroke: var(--color-bg);
    stroke-width: 4.5;
    stroke-linecap: round;
    fill: none;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Tiny screens: the mark alone, app-icon style. */
  @media (max-width: 419.98px) {
    .wordmark {
      display: none;
    }
  }

  /* --- Desktop nav -------------------------------------------------------- */

  .site-nav {
    display: flex;
    gap: var(--space-m);
  }

  .site-nav a {
    position: relative;
    color: var(--color-ink);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    padding-block: var(--space-3xs);
  }

  /* The underline slides in from the left — quiet, 200ms, gone when you leave. */
  .site-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-nav a[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* --- Controls ------------------------------------------------------------- */

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-softer);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }

  .theme-toggle .icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* Search trigger — a wide pill on desktop (icon + shortcut), a plain
     icon button on mobile. The hint text is set per-platform in script. */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    height: 2.5rem;
    padding: 0 0.4rem 0 0.6rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink-muted);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .search-trigger:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-softer);
  }

  .search-trigger:active {
    transform: scale(0.96);
  }

  .search-trigger .icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .search-trigger kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  @media (max-width: 699.98px) {
    .search-trigger {
      width: 2.5rem;
      padding: 0;
      justify-content: center;
    }

    .search-trigger kbd {
      display: none;
    }
  }

  /* Light mode shows the moon ("go dark"); dark mode shows the sun. */
  .icon-sun {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  /* --- Hamburger --------------------------------------------------------------- */

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0 8px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .bar {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 1px;
    background-color: var(--color-ink);
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }

  /* Open state: the bars become an × — the menu's close button lives in place. */
  .nav-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --- Mobile: nav becomes a drop-down panel ---------------------------------- */

  @media (max-width: 767.98px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: var(--space-2xs);
      padding: var(--space-s) var(--space-m) var(--space-m);
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav.is-open a {
      padding-block: var(--space-2xs);
      animation: nav-drop var(--dur-slow) var(--ease-out) both;
    }

    .site-nav.is-open a:nth-child(2) {
      animation-delay: 40ms;
    }
    .site-nav.is-open a:nth-child(3) {
      animation-delay: 80ms;
    }
    .site-nav.is-open a:nth-child(4) {
      animation-delay: 120ms;
    }
  }

  @keyframes nav-drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
