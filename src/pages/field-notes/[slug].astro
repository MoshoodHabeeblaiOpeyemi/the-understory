---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

// One page per field note. Slug = filename stem ("the-tutorial-lie") —
// the same id the search index bakes, so the two URL spellings can't drift.
export async function getStaticPaths() {
  const notes = await getCollection("fieldNotes", ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

// Siblings, newest-first — prev = newer, next = older.
const all = (
  await getCollection("fieldNotes", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const i = all.findIndex((n) => n.id === note.id);
const prev = i > 0 ? all[i - 1] : null;
const next = i < all.length - 1 ? all[i + 1] : null;

// Derived at build time — same math as lessons, never stored.
const words = (note.body ?? "").split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));
const date = new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(
  note.data.date,
);
---

<BaseLayout
  title={`${note.data.title} — Field Notes, The Understory`}
  description={note.data.description}
>
  <article class="note">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/field-notes">Field Notes</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{note.data.title}</span>
    </nav>

    <header class="note-head">
      <p class="section-label">Field note</p>
      <h1>{note.data.title}</h1>
      <div class="note-meta">
        <span class="chip">{date}</span>
        <span class="chip">{minutes} min read</span>
      </div>
    </header>

    <div class="prose note-body">
      <Content />
    </div>

    <nav class="note-nav" aria-label="More field notes">
      {
        prev ? (
          <a class="pn-card" href={`/field-notes/${prev.id}`}>
            <span class="pn-label">← Newer</span>
            <span class="pn-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pn-card pn-next" href={`/field-notes/${next.id}`}>
            <span class="pn-label">Older →</span>
            <span class="pn-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .note {
    max-width: var(--measure);
    margin-inline: auto;
    padding-block: var(--space-xl) 0;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .crumbs a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
  }

  .note-head {
    margin-top: var(--space-s);
  }

  .note-head h1 {
    margin-top: var(--space-2xs);
    font-size: var(--step-4);
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-s);
  }

  .chip {
    padding: 0.2em 0.75em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .note-body {
    margin-top: var(--space-l);
  }

  /* Older/newer — the same two-door pattern as lessons. */
  .note-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-border);
  }

  .pn-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .pn-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .pn-label {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .pn-title {
    color: var(--color-ink);
    font-weight: 600;
    line-height: 1.4;
  }

  .pn-next {
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 600px) {
    .note-nav {
      grid-template-columns: 1fr;
    }

    .pn-next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
