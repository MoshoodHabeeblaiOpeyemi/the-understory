---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkComplete from "../../components/MarkComplete.astro";
import { getCollection, render } from "astro:content";
import modules from "../../data/modules.json";

// THE PRESS, PART 2 — one page per lesson in the vault.
// params.id is the zero-padded day: "day-001" → "001"
export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: { id: String(lesson.data.day).padStart(3, "0") },
    props: { lesson },
  }));
}

// This page's own lesson.
const { lesson } = Astro.props;

// render() turns the Markdown vault entry into the {Content} component —
// {Content} IS the lesson, as HTML.
const { Content } = await render(lesson);

// The full ordered lineup of the vault — for prev/next walking.
const all = (await getCollection("lessons")).sort(
  (a, b) => a.data.day - b.data.day,
);
const i = all.findIndex((l) => l.data.day === lesson.data.day);
const prev = i > 0 ? all[i - 1] : null;
const next = i < all.length - 1 ? all[i + 1] : null;

// Registry lookup gives the breadcrumb its module title.
const moduleMeta = modules.find((m) => m.id === lesson.data.module);

// Reading time: derived at build time from the body — never stored.
const words = (lesson.body ?? "").split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 220));

// Plain-text teaser for the meta description (strip markdown scaffolding).
const blurb = (lesson.body ?? "")
  .replace(/[#*`>\[\]_]/g, " ")
  .replace(/\s+/g, " ")
  .trim()
  .slice(0, 155);
---

<BaseLayout title={`${lesson.data.title} — The Understory`} description={blurb}>
  <article class="lesson">
    <header class="lesson-header">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href={`/modules/${lesson.data.module}`}>
          Module {lesson.data.module}{moduleMeta ? ` · ${moduleMeta.title}` : ""}
        </a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Day {lesson.data.day}</span>
      </nav>

      <div class="lesson-meta">
        <span class="chip chip-day">Day {lesson.data.day}</span>
        <span class="chip">{minutes} min read</span>
        {
          moduleMeta && (
            <a class="chip chip-link" href={`/modules/${lesson.data.module}`}>
              {moduleMeta.emoji} {moduleMeta.title}
            </a>
          )
        }
      </div>

      <h1>{lesson.data.title}</h1>
    </header>

    <div class="prose lesson-body">
      <Content />
    </div>

    <MarkComplete slug={`day-${String(lesson.data.day).padStart(3, "0")}`} />

    <nav class="lesson-nav" aria-label="Lesson navigation">
      {
        prev ? (
          <a
            class="pn-card pn-prev"
            href={`/lessons/${String(prev.data.day).padStart(3, "0")}`}
          >
            <span class="pn-label">← Previous</span>
            <span class="pn-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            class="pn-card pn-next"
            href={`/lessons/${String(next.data.day).padStart(3, "0")}`}
          >
            <span class="pn-label">Next →</span>
            <span class="pn-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <!-- Thumb-reach nav: fixed to the viewport floor on phones, so the
         next lesson is always one tap away — never scrolled out of reach. -->
    <nav class="thumb-nav" aria-label="Lesson navigation (quick)">
      {
        prev ? (
          <a class="thumb-prev" href={`/lessons/${String(prev.data.day).padStart(3, "0")}`}>
            <span aria-hidden="true">←</span> Previous
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="thumb-next" href={`/lessons/${String(next.data.day).padStart(3, "0")}`}>
            Next <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>


<style>
  .lesson {
    max-width: var(--measure);
    margin-inline: auto;
    padding-block: var(--space-xl) 0;
    /* Mobile reading fix: gutters on small screens, where the container
       max-width isn't the binding constraint. */
    padding-inline: var(--space-s);
  }

  @media (min-width: 480px) {
    .lesson {
      padding-inline: var(--space-l);
    }
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .crumbs a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
  }

  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-s);
  }

  .chip {
    padding: 0.2em 0.75em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .chip-day {
    font-family: var(--font-mono);
    background-color: var(--color-accent-softer);
    border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    color: var(--color-accent);
    font-weight: 600;
  }

  .chip-link {
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .chip-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-softer);
  }

  .lesson-header h1 {
    margin-top: var(--space-s);
    font-size: var(--step-4);
  }

  .lesson-body {
    margin-top: var(--space-l);
  }

  /* Prev/next: two doors out of the lesson, styled as cards. */
  .lesson-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-border);
  }

  .pn-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .pn-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    box-shadow: var(--shadow-sm);
  }

  .pn-prev:hover {
    transform: translateX(-2px);
  }

  .pn-next:hover {
    transform: translateX(2px);
  }

  .pn-label {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .pn-title {
    color: var(--color-ink);
    font-weight: 600;
    line-height: 1.4;
  }

  .pn-next {
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 600px) {
    .lesson-nav {
      grid-template-columns: 1fr;
    }

    .pn-next {
      align-items: flex-start;
      text-align: left;
    }
  }

  /* --- Thumb nav: mobile only, floats above content, themed --------------- */

  .thumb-nav {
    display: none;
  }

  @media (max-width: 700px) {
    .thumb-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 40;
      display: flex;
      justify-content: space-between;
      gap: var(--space-2xs);
      padding: var(--space-2xs) var(--space-s);
      padding-bottom: max(var(--space-2xs), env(safe-area-inset-bottom));
      background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--color-border);
    }

    .thumb-nav a {
      flex: 1;
      max-width: 10rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3xs);
      padding: 0.6em 1em;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-ink);
      font-size: var(--step--1);
      font-weight: 600;
      text-decoration: none;
      box-shadow: var(--shadow-sm);
      transition:
        border-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }

    .thumb-nav a:active {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    /* Room so the bar never covers the last line of the lesson. */
    .lesson {
      padding-bottom: 4.5rem;
    }
  }
</style>
