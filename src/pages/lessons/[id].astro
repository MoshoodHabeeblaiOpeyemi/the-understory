---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

// THE PRESS, PART 2 — one page per lesson in the vault.
// params.id will be the number part of the filename: "day-001" → "001"
export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: { id: String(lesson.data.day).padStart(3, "0") },
    props: { lesson },
  }));
}

// This page's own lesson.
const { lesson } = Astro.props;

// THE NEW SPELL: render().
// A Markdown file is just text. render() turns it into
// ready-to-display components — {Content} IS the lesson, as HTML.
const { Content } = await render(lesson);

// The full ordered lineup of the vault — for prev/next walking.
const all = await getCollection("lessons");
all.sort((a, b) => a.data.day - b.data.day);

const i = all.findIndex((l) => l.data.day === lesson.data.day);
const prev = i > 0 ? all[i - 1] : null;
const next = i < all.length - 1 ? all[i + 1] : null;
---

<BaseLayout title={`${lesson.data.title} — The Understory`}>
  <article class="lesson">
    <header class="lesson-header">
      <p class="lesson-crumb">
        <a href={`/modules/${lesson.data.module}`}>Module {lesson.data.module}</a>
        · Day {lesson.data.day}
      </p>
      <h1>{lesson.data.title}</h1>
    </header>

    <div class="lesson-body">
      <Content />
    </div>

    <nav class="lesson-nav">
      {
        prev ? (
          <a class="nav-prev" href={`/lessons/${String(prev.data.day).padStart(3, "0")}`}>
            ← Day {prev.data.day}: {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="nav-next" href={`/lessons/${String(next.data.day).padStart(3, "0")}`}>
            Day {next.data.day}: {next.data.title} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .lesson {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }
  .lesson-crumb {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .lesson-crumb a {
    color: inherit;
    text-decoration: none;
  }
  .lesson-crumb a:hover {
    text-decoration: underline;
  }

  .lesson-body {
    line-height: 1.7;
  }
  .lesson-body :global(h2) {
    margin-top: var(--space-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--text-color) 15%, transparent);
    padding-bottom: 0.3rem;
  }
  .lesson-body :global(a) {
    color: var(--accent-color);
  }
  .lesson-body :global(code) {
    background: color-mix(in srgb, var(--text-color) 10%, transparent);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.9em;
  }
  .lesson-body :global(pre) {
    background: color-mix(in srgb, var(--text-color) 10%, transparent);
    border-radius: 8px;
    padding: var(--space-md);
    overflow-x: auto;
  }
  .lesson-body :global(blockquote) {
    border-left: 3px solid var(--accent-color);
    margin: 0;
    padding-left: var(--space-md);
    opacity: 0.85;
  }

  .lesson-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--text-color) 15%, transparent);
  }
  .lesson-nav a {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
  }
  .lesson-nav a:hover {
    text-decoration: underline;
  }
  .nav-next {
    text-align: right;
  }
</style>
