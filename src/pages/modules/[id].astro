---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReaderProgress from "../../components/ReaderProgress.astro";
import { getCollection } from "astro:content";
import modules from "../../data/modules.json";

// THE PRINTING PRESS
// Astro calls this once at build time and asks:
// "For [id].astro — which values of id should I print a page for?"
// We answer with 18 objects: one per module.
//  - params:  what goes INTO the [id] slot (must be a string)
//  - props:   the data each printed page receives, ready to display
export function getStaticPaths() {
  return modules.map((m) => ({
    params: { id: String(m.id) },
    props: { module: m },
  }));
}

// Everything below runs 18 times — once per printed page.
const { module } = Astro.props;
const lessons = await getCollection("lessons", ({ data }) => !data.draft);

// For the day list: look up whether THIS module's shelf has a lesson
// filed at this exact day number.
const lessonFor = (day: number) =>
  lessons.find((lesson) => lesson.data.module === module.id && lesson.data.day === day);
---

<BaseLayout title={`${module.title} — The Understory`} description={module.tagline}>
  <section class="module-hero container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Module {module.id}</span>
    </nav>
    <span class="module-emoji" aria-hidden="true">{module.emoji}</span>
    <p class="section-label">
      Module {module.id} of {modules.length} · Days {module.dayStart}–{module.dayEnd}
    </p>
    <h1>{module.title}</h1>
    <p class="module-tagline">{module.tagline}</p>

    <ReaderProgress total={module.dayEnd - module.dayStart + 1} />
  </section>

  <ol class="day-list" data-reveal>
    {
      Array.from({ length: module.dayEnd - module.dayStart + 1 }, (_, i) => {
        const day = module.dayStart + i;
        const lesson = lessonFor(day);
        return lesson ? (
          <li class="day-item">
            <a
              class="day-link"
              href={`/lessons/${String(day).padStart(3, "0")}`}
              data-day={day}
            >
              <span class="day-number">Day {day}</span>
              <span class="day-title">{lesson.data.title}</span>
              <span class="day-read">
                {Math.max(
                  1,
                  Math.round((lesson.body ?? "").split(/\s+/).length / 220),
                )}{" "}
                min
              </span>
              <span class="day-check" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
              </span>
              <span class="day-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ) : (
          <li class="day-item">
            <span class="day-link coming">
              <span class="day-number">Day {day}</span>
              <span class="day-title">Coming soon</span>
            </span>
          </li>
        );
      })
    }
  </ol>

  <p class="end-door">
    <a class="back-link" href="/">↑ All modules</a>
  </p>
</BaseLayout>

<style>
  .module-hero {
    padding-block: var(--space-2xl) var(--space-xl);
    text-align: center;
    background: radial-gradient(
      50rem 20rem at 50% -4rem,
      var(--color-accent-soft),
      transparent 70%
    );
  }

  .back-link {
    display: inline-block;
    padding: 0.3em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .back-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-softer);
  }

  .module-emoji {
    display: inline-grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: var(--color-accent-soft);
    font-size: 2rem;
  }

  .module-hero h1 {
    margin-top: var(--space-s);
    font-size: var(--step-4);
  }

  .module-tagline {
    max-width: 36rem;
    margin: var(--space-s) auto 0;
    color: var(--color-ink-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .day-list {
    list-style: none;
    max-width: 44rem;
    margin: 0 auto var(--space-2xl);
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .day-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-m);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  a.day-link:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background-color: var(--color-accent-softer);
    transform: translateX(4px);
  }

  .day-number {
    min-width: 4.2rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  .day-title {
    flex: 1;
    font-weight: 500;
  }

  /* The arrow waits off-stage and slides in on hover. */
  .day-arrow {
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  a.day-link:hover .day-arrow {
    opacity: 1;
    transform: none;
  }

  /* Reading time — desktop only; the row is the schedule on small screens. */
  .day-read {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .day-read {
      display: none;
    }
  }

  /* The check: invisible until the reader has finished that day. */
  .day-check {
    display: none;
    align-self: center;
    color: var(--color-accent);
  }

  .day-check svg {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
  }

  a.day-link.is-complete .day-check {
    display: inline-flex;
    animation: check-pop var(--dur-base) var(--ease-out);
  }

  @keyframes check-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Unwritten days: dashed frame, quiet voice — visible, not shouting. */
  .coming {
    border-style: dashed;
    background-color: transparent;
    color: var(--color-ink-muted);
  }

  .coming .day-title {
    font-style: italic;
    font-weight: 400;
  }

  /* Wayfinding: Home is always one tap away — top and bottom of the list. */
  .crumbs {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-m);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .crumbs a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
  }

  .end-door {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }
</style>

<script>
  import {
    getProgress,
    onProgressChange,
    slugForDay,
  } from "../../scripts/progress.ts";

  // Reflect reader progress on the day rows: completed days earn their check.
  function render() {
    const map = getProgress();
    document
      .querySelectorAll<HTMLAnchorElement>(".day-link[data-day]")
      .forEach((row) => {
        const day = Number(row.dataset.day);
        const done = Boolean(map[slugForDay(day)]?.completedAt);
        row.classList.toggle("is-complete", done);
      });
  }

  onProgressChange(render);
</script>

